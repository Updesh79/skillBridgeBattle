# ==============================================================================
# SKILLBRIDGE – MICRO-SKILL EXCHANGE & PEER LEARNING PLATFORM (.env)
# ==============================================================================

# 1. Server & Runtime Configuration
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# 2. Session & Authentication Signing Secret (HMAC-SHA256)
SESSION_SECRET="skillbridge-academic-hmac-secret-2026"

# 3. Gemini AI API Key (Used for 1 vs 1 Skill Battle AI Question Generation)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 4. PostgreSQL / Google Cloud SQL Database Configuration
# For local PostgreSQL, set SQL_HOST="localhost"
# For Cloud SQL socket, set SQL_HOST="/cloudsql/project:region:instance"
SQL_HOST="localhost"
SQL_DB_NAME="postgres"
SQL_USER="postgres"
SQL_PASSWORD="your_postgres_password"

# 5. Drizzle Kit Schema Migration Admin Credentials
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_postgres_password"
